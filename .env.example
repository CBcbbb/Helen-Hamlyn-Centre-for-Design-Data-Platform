# Copy to .env.local for local development. Never commit real values.

# Absolute site URL for canonical links, Open Graph and sitemap.xml.
# On Vercel the production domain is used automatically if this is unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin editor (/admin). Leave unset to switch the admin off.
# ADMIN_SESSION_SECRET must be at least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
